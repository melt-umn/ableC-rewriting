#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <arena.h>
#include <string.xh>

#ifndef _REWRITING_XH
#define _REWRITING_XH

struct generic_closure {
  const char *fn_name;
  void *env;
  void *fn;
};

typedef unsigned long type_id;

typedef __attribute__((refId("edu:umn:cs:melt:exts:ableC:rewriting:strategy")))
  datatype strategy *strategy;

static inline size_t _showArenaMaxLen(arena_t ar) {
  return MAX_POINTER_STR_LEN + 8;
}
static inline size_t _showArenaToBuf(char *buf, arena_t ar) {
  return sprintf(buf, "<arena %p>", ar);
}
show arena_t with _showArenaMaxLen, _showArenaToBuf;

static inline size_t _showRecMaxLen(closure<(strategy) -> strategy> f) {
  return showMaxLen(*(struct generic_closure *)&f);
}
static inline size_t _showRecToBuf(char *buf, closure<(strategy) -> strategy> f) {
  return showToBuf(buf, *(struct generic_closure *)&f);
}
show(closure<(strategy) -> strategy>) with _showRecMaxLen, _showRecToBuf;

datatype strategy {
  Fail();
  Id();
  Choice(strategy s1, strategy s2);
  Sequence(strategy s1, strategy s2);
  Neg(strategy s);
  One(strategy s, arena_t ar);
  All(strategy s, arena_t ar);
  Rec(closure<(strategy) -> strategy> f);
  Action(type_id id, struct generic_closure f);
  Rule(type_id id, struct generic_closure f);
};

template<typename a>
_Bool rewrite(const strategy s, const a term, a *const result) {
#ifdef DEBUG_TRACE_REWRITE
  with_arena tmp {
    printf("Rewriting %s with %s\n", show(term).text, show(s).text);
  }
#endif
  match (s) {
    &Fail() -> {
      return 0;
    }
    &Id() -> {
      if (result) {
        *result = term;
      }
      return 1;
    }
    &Choice(s1, s2) -> {
      return rewrite(s1, term, result) || rewrite(s2, term, result);
    }
    &Sequence(s1, s2) -> {
      a tmp;
      return rewrite(s1, term, &tmp) && rewrite(s2, tmp, result);
    }
    &Neg(s) -> {
      return !rewrite(s, term, NULL);
    }
    &One(s, ar) -> {
      allocate_using arena ar;
      return _rewrite_one(s, term, result);
    }
    &All(s, ar) -> {
      allocate_using arena ar;
      return _rewrite_all(s, term, result);
    }
    &Rec(f) -> {
      return rewrite(f(s), term, result);
    }
    &Action(id, f) -> {
      if (_type_id(a) == id) {
        (*(closure<(a term) -> void> *)&f)(term);
      }
      if (result) {
        *result = term;
      }
      return 1;
    }
    &Rule(id, f) -> {
      if (_type_id(a) == id) {
        return (*(closure<(a term, a *result) -> _Bool> *)&f)(term, result);
      } else {
        return 0;
      }
    }
    _ -> {
      with_arena tmp {
        fprintf(stderr, "Invalid strategy to rewrite: %s\n", show(s).text);
      }
      abort();
    }
  }
}

// Strategy construction helpers
static datatype strategy fail[] = {{.tag = strategy_Fail}};
static datatype strategy id[] = {{.tag = strategy_Id}};

static inline strategy neg(strategy s, arena_t ar) {
  allocate_using arena ar;
  return new Neg(s);
}
static inline strategy one(strategy s, arena_t ar) {
  allocate_using arena ar;
  return new One(s, ar);
}
static inline strategy all(strategy s, arena_t ar) {
  allocate_using arena ar;
  return new All(s, ar);
}
static inline strategy rec(closure<(strategy) -> strategy> f, arena_t ar) {
  allocate_using arena ar;
  return new Rec(f);
}

// Generally useful strategy constructors
static inline strategy try(strategy s, arena_t ar) {
  allocate_using arena ar;
  return s <+ id;
}

static inline strategy repeat(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> try(s <* self, ar), ar);
}

static inline strategy bottomUp(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> all(self, ar) <* s, ar);
}

static inline strategy topDown(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> s <* all(self, ar), ar);
}

static inline strategy downUp(strategy s1, strategy s2, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> s1 <* all(self, ar) <* s2, ar);
}

static inline strategy onceBottomUp(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> one(self, ar) <+ s, ar);
}

static inline strategy onceTopDown(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> s <+ one(self, ar), ar);
}

static inline strategy allTopDown(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> s <+ all(self, ar), ar);
}

static inline strategy innermost(strategy s, arena_t ar) {
  allocate_using arena ar;
  return rec(lambda (strategy self) -> bottomUp(try(s <* self, ar), ar), ar);
}

static inline strategy outermost(strategy s, arena_t ar) {
  allocate_using arena ar;
  return repeat(onceTopDown(s, ar), ar);
}

#endif
